{
  "name": "simple-ecommerce",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON lib/db/migrate.ts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON lib/db/seed.ts",
    "db:reset": "rm -f data/app.db data/app.db-* && bun run db:migrate && bun run db:seed",
    "images:download": "bun run scripts/download-seed-images.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "SQLITE_PATH=data/test.db SESSION_SECRET=test-secret-32-chars-min-do-not-use-prod E2E_PORT=3100 E2E_BASE_URL=http://localhost:3100 playwright test",
    "test:e2e:ui": "SQLITE_PATH=data/test.db SESSION_SECRET=test-secret-32-chars-min-do-not-use-prod E2E_PORT=3100 E2E_BASE_URL=http://localhost:3100 playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@tanstack/react-form": "~1.29.1",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-query-devtools": "^5.100.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iron-session": "^8.0.4",
    "ky": "^2.0.2",
    "kysely": "^0.28.16",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "shadcn": "^4.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "better-sqlite3",
    "sharp",
    "unrs-resolver"
  ]
}
